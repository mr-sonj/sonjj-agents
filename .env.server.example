# Copy to .env.server.local for local headless server development.
# The config dir is intentionally repo-local so it can run alongside the macOS app.
CRAFT_CONFIG_DIR=.craft-agent-server
CRAFT_RPC_HOST=127.0.0.1
# Use 0 to auto-pick an available port. Set a fixed port if a client needs a stable URL.
CRAFT_RPC_PORT=0
CRAFT_SERVER_TOKEN=replace-with-a-generated-token
